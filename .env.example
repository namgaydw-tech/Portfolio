# Local API storage. Production automatically uses Vercel Blob when
# BLOB_READ_WRITE_TOKEN is provided by the connected Blob store.
CONTACT_STORAGE=sqlite
CONTACT_DB_PATH=data/contact_messages.db
ALLOWED_ORIGINS=http://localhost:5173

# Set by Vercel Blob in production. Never commit a real value.
BLOB_READ_WRITE_TOKEN=

